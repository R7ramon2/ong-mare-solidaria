{
  "name": "ong-mare-solidaria",
  "version": "1.1.0",
  "description": "Site da ONG Maré Solidária: HTML semântico, CSS com design system e SPA em JavaScript modular.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "http-server . -p 8080 -c-1 -o html/index.html",
